{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc"],
  "ignorePatterns": [
    "node_modules/**",
    "dist/**",
    "coverage/**",
    "**/*.tgz",
    "src/catalog/inventory.generated.*",
    "docs",
    "docs/**/*",
    "demo/node_modules/**",
    "demo/out/**",
    "demo/public/**"
  ]
}
