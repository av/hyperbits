{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "lava-dither",
  "type": "hyperframes:block",
  "title": "Error-Diffusion Lava",
  "description": "Slow metaball lava rendered through Floyd-Steinberg error diffusion into three inks, so the blobs crawl with living organic grain as they merge and split",
  "tags": [
    "background",
    "dither",
    "pixel",
    "organic"
  ],
  "license": "MIT",
  "dimensions": {
    "width": 1920,
    "height": 1080
  },
  "duration": 10,
  "files": [
    {
      "path": "index.html",
      "target": "compositions/lava-dither.html",
      "type": "hyperframes:composition"
    },
    {
      "path": "hyperbits.iife.js",
      "target": "compositions/hyperbits.iife.js",
      "type": "hyperframes:asset"
    }
  ],
  "variables": [
    {
      "id": "blobs",
      "type": "number",
      "label": "Blobs",
      "default": 7
    },
    {
      "id": "seed",
      "type": "number",
      "label": "Seed",
      "default": 2
    },
    {
      "id": "background",
      "type": "color",
      "label": "Background",
      "default": "#100f0f"
    },
    {
      "id": "foreground",
      "type": "color",
      "label": "Hot ink",
      "default": "#f2f0e5"
    },
    {
      "id": "accent",
      "type": "color",
      "label": "Lava ink",
      "default": "#ec8b49"
    }
  ]
}
