{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "vector-scope",
  "type": "hyperframes:block",
  "title": "Vector Scope",
  "description": "An amber-phosphor XY oscilloscope tracing Lissajous figures that morph through frequency ratios, with beam persistence, bloom, a graticule and live channel readouts",
  "tags": [
    "crt",
    "hud",
    "retro",
    "science",
    "glow"
  ],
  "license": "MIT",
  "dimensions": {
    "width": 1920,
    "height": 1080
  },
  "duration": 10,
  "files": [
    {
      "path": "index.html",
      "target": "compositions/vector-scope.html",
      "type": "hyperframes:composition"
    },
    {
      "path": "hyperbits.iife.js",
      "target": "compositions/hyperbits.iife.js",
      "type": "hyperframes:asset"
    }
  ],
  "variables": [
    {
      "id": "label",
      "type": "string",
      "label": "Screen label",
      "default": "XY MODE / CH1 + CH2"
    },
    {
      "id": "background",
      "type": "color",
      "label": "Background",
      "default": "#100f0f"
    },
    {
      "id": "foreground",
      "type": "color",
      "label": "Beam core",
      "default": "#f2f0e5"
    },
    {
      "id": "accent",
      "type": "color",
      "label": "Phosphor",
      "default": "#ec8b49"
    }
  ]
}
