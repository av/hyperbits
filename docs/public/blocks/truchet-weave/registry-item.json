{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "truchet-weave",
  "type": "hyperframes:block",
  "title": "Truchet Arcs",
  "description": "Gently curving bands of Truchet arcs across the frame, from a centre far off the corner, neighbouring bands gliding slowly in opposite directions",
  "tags": [
    "loop",
    "background",
    "shapes",
    "truchet",
    "pattern"
  ],
  "license": "MIT",
  "dimensions": {
    "width": 1920,
    "height": 1080
  },
  "duration": 12,
  "files": [
    {
      "path": "index.html",
      "target": "compositions/truchet-weave.html",
      "type": "hyperframes:composition"
    },
    {
      "path": "hyperbits.iife.js",
      "target": "compositions/hyperbits.iife.js",
      "type": "hyperframes:asset"
    }
  ],
  "variables": [
    {
      "id": "background",
      "type": "color",
      "label": "Background",
      "default": "#100f0f"
    },
    {
      "id": "foreground",
      "type": "color",
      "label": "Foreground",
      "default": "#f2f0e5"
    },
    {
      "id": "accent",
      "type": "color",
      "label": "Accent",
      "default": "#9d8af0"
    },
    {
      "id": "rings",
      "type": "number",
      "label": "Bands",
      "default": 11
    },
    {
      "id": "seed",
      "type": "number",
      "label": "Seed",
      "default": 6
    }
  ]
}
