{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "step-timing-context",
  "type": "hyperframes:block",
  "title": "Step-Aware Motion Timing",
  "description": "Demonstrates useMotionTiming context awareness in Scene3D Steps",
  "tags": [
    "3d",
    "timing",
    "animation",
    "context"
  ],
  "license": "MIT",
  "dimensions": {
    "width": 1920,
    "height": 1080
  },
  "duration": 10,
  "files": [
    {
      "path": "index.html",
      "target": "compositions/step-timing-context.html",
      "type": "hyperframes:composition"
    },
    {
      "path": "hyperbits.iife.js",
      "target": "compositions/hyperbits.iife.js",
      "type": "hyperframes:asset"
    }
  ],
  "variables": [
    {
      "id": "title",
      "type": "string",
      "label": "First heading",
      "default": "Step 1"
    },
    {
      "id": "color",
      "type": "color",
      "label": "Text color",
      "default": "#fcc192"
    },
    {
      "id": "background",
      "type": "color",
      "label": "Background",
      "default": "#100f0f"
    }
  ]
}
