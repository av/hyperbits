{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "char-by-char",
  "type": "hyperframes:block",
  "title": "Staggered Char Animation",
  "description": "Text that appears character by character with staggered timing",
  "tags": [
    "text",
    "character",
    "stagger"
  ],
  "license": "MIT",
  "dimensions": {
    "width": 1920,
    "height": 1080
  },
  "duration": 4,
  "files": [
    {
      "path": "index.html",
      "target": "compositions/char-by-char.html",
      "type": "hyperframes:composition"
    },
    {
      "path": "hyperbits.iife.js",
      "target": "compositions/hyperbits.iife.js",
      "type": "hyperframes:asset"
    }
  ],
  "variables": [
    {
      "id": "text",
      "type": "string",
      "label": "Text",
      "default": "Character Animation"
    },
    {
      "id": "color",
      "type": "color",
      "label": "Text color",
      "default": "#fcc192"
    },
    {
      "id": "background",
      "type": "color",
      "label": "Background",
      "default": "#100f0f"
    }
  ]
}
