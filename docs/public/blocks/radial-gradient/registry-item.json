{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "radial-gradient",
  "type": "hyperframes:block",
  "title": "Radial Gradient",
  "description": "Smooth transition between radial gradients",
  "tags": [
    "background",
    "gradient",
    "radial"
  ],
  "license": "MIT",
  "dimensions": {
    "width": 1920,
    "height": 1080
  },
  "duration": 3,
  "files": [
    {
      "path": "index.html",
      "target": "compositions/radial-gradient.html",
      "type": "hyperframes:composition"
    },
    {
      "path": "hyperbits.iife.js",
      "target": "compositions/hyperbits.iife.js",
      "type": "hyperframes:asset"
    }
  ],
  "variables": [
    {
      "id": "color1Start",
      "type": "color",
      "label": "Gradient 1 Start",
      "default": "#FDB813"
    },
    {
      "id": "color1End",
      "type": "color",
      "label": "Gradient 1 End",
      "default": "#78C0E0"
    },
    {
      "id": "color2Start",
      "type": "color",
      "label": "Gradient 2 Start",
      "default": "#F5576C"
    },
    {
      "id": "color2End",
      "type": "color",
      "label": "Gradient 2 End",
      "default": "#2F2044"
    }
  ]
}
