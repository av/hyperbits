{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "ascii-torus",
  "type": "hyperframes:block",
  "title": "ASCII Torus",
  "description": "A z-buffered torus tumbling in a grid of monospace glyphs, decoding out of noise and lit through a twelve-step character ramp",
  "tags": [
    "3d",
    "ascii",
    "retro",
    "generative"
  ],
  "license": "MIT",
  "dimensions": {
    "width": 1920,
    "height": 1080
  },
  "duration": 8,
  "files": [
    {
      "path": "index.html",
      "target": "compositions/ascii-torus.html",
      "type": "hyperframes:composition"
    },
    {
      "path": "hyperbits.iife.js",
      "target": "compositions/hyperbits.iife.js",
      "type": "hyperframes:asset"
    }
  ],
  "variables": [
    {
      "id": "caption",
      "type": "string",
      "label": "Caption",
      "default": "RENDERED IN TWELVE GLYPHS"
    },
    {
      "id": "background",
      "type": "color",
      "label": "Background",
      "default": "#100f0f"
    },
    {
      "id": "foreground",
      "type": "color",
      "label": "Bright glyphs",
      "default": "#f2f0e5"
    },
    {
      "id": "accent",
      "type": "color",
      "label": "Accent",
      "default": "#ec8b49"
    }
  ]
}
