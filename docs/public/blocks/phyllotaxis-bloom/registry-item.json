{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "phyllotaxis-bloom",
  "type": "hyperframes:block",
  "title": "Bloom Wallpaper",
  "description": "A wallpaper of small phyllotaxis flower heads whose petals open and close in a slow wave travelling across the frame",
  "tags": [
    "loop",
    "background",
    "dots",
    "spiral",
    "organic"
  ],
  "license": "MIT",
  "dimensions": {
    "width": 1920,
    "height": 1080
  },
  "duration": 12,
  "files": [
    {
      "path": "index.html",
      "target": "compositions/phyllotaxis-bloom.html",
      "type": "hyperframes:composition"
    },
    {
      "path": "hyperbits.iife.js",
      "target": "compositions/hyperbits.iife.js",
      "type": "hyperframes:asset"
    }
  ],
  "variables": [
    {
      "id": "background",
      "type": "color",
      "label": "Background",
      "default": "#f2f0e5"
    },
    {
      "id": "foreground",
      "type": "color",
      "label": "Foreground",
      "default": "#100f0f"
    },
    {
      "id": "accent",
      "type": "color",
      "label": "Accent",
      "default": "#ef5da8"
    },
    {
      "id": "dots",
      "type": "number",
      "label": "Florets per flower",
      "default": 90
    }
  ]
}
