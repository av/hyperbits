{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "feature-showcase",
  "type": "hyperframes:block",
  "title": "Hyperbits",
  "description": "Promotional showcase for the hyperbits catalog of HyperFrames animation bits.",
  "tags": [
    "showcase",
    "promo",
    "library"
  ],
  "license": "MIT",
  "dimensions": {
    "width": 1920,
    "height": 1080
  },
  "duration": 38,
  "files": [
    {
      "path": "index.html",
      "target": "compositions/feature-showcase.html",
      "type": "hyperframes:composition"
    },
    {
      "path": "hyperbits.iife.js",
      "target": "compositions/hyperbits.iife.js",
      "type": "hyperframes:asset"
    }
  ],
  "variables": [
    {
      "id": "title",
      "type": "string",
      "label": "Title",
      "default": "hyperbits"
    },
    {
      "id": "color",
      "type": "color",
      "label": "Accent",
      "default": "#fcc192"
    },
    {
      "id": "background",
      "type": "color",
      "label": "Background",
      "default": "#100f0f"
    }
  ]
}
