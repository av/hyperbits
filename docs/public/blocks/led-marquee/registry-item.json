{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "led-marquee",
  "type": "hyperframes:block",
  "title": "LED Matrix Sign",
  "description": "A dot-matrix LED sign in a dark housing: a message scrolls across the glowing dots, then a second line wipes in column by column and pulses",
  "tags": [
    "text",
    "pixel",
    "retro",
    "glow"
  ],
  "license": "MIT",
  "dimensions": {
    "width": 1920,
    "height": 1080
  },
  "duration": 8,
  "files": [
    {
      "path": "index.html",
      "target": "compositions/led-marquee.html",
      "type": "hyperframes:composition"
    },
    {
      "path": "hyperbits.iife.js",
      "target": "compositions/hyperbits.iife.js",
      "type": "hyperframes:asset"
    }
  ],
  "variables": [
    {
      "id": "message",
      "type": "string",
      "label": "Scrolling message",
      "default": "NOW SHOWING: NEW BITS FOR HYPERFRAMES +++"
    },
    {
      "id": "headline",
      "type": "string",
      "label": "Final line",
      "default": "HYPERBITS"
    },
    {
      "id": "background",
      "type": "color",
      "label": "Background",
      "default": "#100f0f"
    },
    {
      "id": "foreground",
      "type": "color",
      "label": "Hot core",
      "default": "#f2f0e5"
    },
    {
      "id": "accent",
      "type": "color",
      "label": "LED colour",
      "default": "#ec8b49"
    }
  ]
}
