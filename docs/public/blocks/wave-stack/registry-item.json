{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "wave-stack",
  "type": "hyperframes:block",
  "title": "Ribbon Field",
  "description": "Muted striped ribbons laid diagonally across the whole frame, each slowly twisting so its back face shows",
  "tags": [
    "loop",
    "background",
    "lines",
    "waves",
    "ribbon"
  ],
  "license": "MIT",
  "dimensions": {
    "width": 1920,
    "height": 1080
  },
  "duration": 12,
  "files": [
    {
      "path": "index.html",
      "target": "compositions/wave-stack.html",
      "type": "hyperframes:composition"
    },
    {
      "path": "hyperbits.iife.js",
      "target": "compositions/hyperbits.iife.js",
      "type": "hyperframes:asset"
    }
  ],
  "variables": [
    {
      "id": "background",
      "type": "color",
      "label": "Background",
      "default": "#100f0f"
    },
    {
      "id": "foreground",
      "type": "color",
      "label": "Foreground",
      "default": "#f2f0e5"
    },
    {
      "id": "accent",
      "type": "color",
      "label": "Accent",
      "default": "#f2652a"
    },
    {
      "id": "lines",
      "type": "number",
      "label": "Ribbons",
      "default": 6
    }
  ]
}
