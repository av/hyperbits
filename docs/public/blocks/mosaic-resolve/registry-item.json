{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "mosaic-resolve",
  "type": "hyperframes:block",
  "title": "Mosaic Resolve",
  "description": "A title card that steps out of giant palette-quantised mosaic blocks into crisp type and a striped retro sun, holds, then shatters back into tiles that blink out",
  "tags": [
    "text",
    "pixel",
    "reveal",
    "retro",
    "title"
  ],
  "license": "MIT",
  "dimensions": {
    "width": 1920,
    "height": 1080
  },
  "duration": 7,
  "files": [
    {
      "path": "index.html",
      "target": "compositions/mosaic-resolve.html",
      "type": "hyperframes:composition"
    },
    {
      "path": "hyperbits.iife.js",
      "target": "compositions/hyperbits.iife.js",
      "type": "hyperframes:asset"
    }
  ],
  "variables": [
    {
      "id": "headline",
      "type": "string",
      "label": "Headline",
      "default": "Low res, high taste"
    },
    {
      "id": "label",
      "type": "string",
      "label": "Label",
      "default": "EPISODE 08 / PIXEL WORKS"
    },
    {
      "id": "background",
      "type": "color",
      "label": "Background",
      "default": "#100f0f"
    },
    {
      "id": "foreground",
      "type": "color",
      "label": "Foreground",
      "default": "#f2f0e5"
    },
    {
      "id": "accent",
      "type": "color",
      "label": "Accent",
      "default": "#ec8b49"
    }
  ]
}
