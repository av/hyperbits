{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "contour-drift",
  "type": "hyperframes:block",
  "title": "Terraced Relief",
  "description": "A frame-wide relief of softly lifted contour terraces, the low hills reshaping slowly as the layers breathe",
  "tags": [
    "loop",
    "background",
    "lines",
    "contours",
    "topographic"
  ],
  "license": "MIT",
  "dimensions": {
    "width": 1920,
    "height": 1080
  },
  "duration": 12,
  "files": [
    {
      "path": "index.html",
      "target": "compositions/contour-drift.html",
      "type": "hyperframes:composition"
    },
    {
      "path": "hyperbits.iife.js",
      "target": "compositions/hyperbits.iife.js",
      "type": "hyperframes:asset"
    }
  ],
  "variables": [
    {
      "id": "background",
      "type": "color",
      "label": "Background",
      "default": "#100f0f"
    },
    {
      "id": "foreground",
      "type": "color",
      "label": "Foreground",
      "default": "#f2f0e5"
    },
    {
      "id": "accent",
      "type": "color",
      "label": "Accent",
      "default": "#f2652a"
    },
    {
      "id": "levels",
      "type": "number",
      "label": "Terraces",
      "default": 9
    },
    {
      "id": "seed",
      "type": "number",
      "label": "Seed",
      "default": 4
    }
  ]
}
