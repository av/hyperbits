{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "fade-in",
  "type": "hyperframes:block",
  "title": "Fade In",
  "description": "Simple fade-in text animation from transparent to opaque",
  "tags": [
    "text",
    "fade",
    "basic"
  ],
  "license": "MIT",
  "dimensions": {
    "width": 1920,
    "height": 1080
  },
  "duration": 3,
  "files": [
    {
      "path": "index.html",
      "target": "compositions/fade-in.html",
      "type": "hyperframes:composition"
    },
    {
      "path": "hyperbits.iife.js",
      "target": "compositions/hyperbits.iife.js",
      "type": "hyperframes:asset"
    }
  ],
  "variables": [
    {
      "id": "text",
      "type": "string",
      "label": "Text",
      "default": "Hello World"
    },
    {
      "id": "color",
      "type": "color",
      "label": "Text color",
      "default": "#fcc192"
    },
    {
      "id": "background",
      "type": "color",
      "label": "Background",
      "default": "#100f0f"
    }
  ]
}
