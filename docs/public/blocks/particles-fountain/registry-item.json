{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "particles-fountain",
  "type": "hyperframes:block",
  "title": "Fountain",
  "description": "Bursting fountain particles effect",
  "tags": [
    "particles",
    "burst",
    "fountain"
  ],
  "license": "MIT",
  "dimensions": {
    "width": 1920,
    "height": 1080
  },
  "duration": 2,
  "files": [
    {
      "path": "index.html",
      "target": "compositions/particles-fountain.html",
      "type": "hyperframes:composition"
    },
    {
      "path": "hyperbits.iife.js",
      "target": "compositions/hyperbits.iife.js",
      "type": "hyperframes:asset"
    }
  ],
  "variables": [
    {
      "id": "color",
      "type": "color",
      "label": "Spark color",
      "default": "#ebb03b"
    },
    {
      "id": "background",
      "type": "color",
      "label": "Background",
      "default": "#100f0f"
    }
  ]
}
