{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "dither-type",
  "type": "hyperframes:block",
  "title": "Dither Dissolve",
  "description": "A headline that materialises through an 8x8 Bayer threshold sweep, printed in three inks with a dithered halo and a drifting light behind it, then dissolves back into the screen",
  "tags": [
    "text",
    "dither",
    "pixel",
    "reveal",
    "retro"
  ],
  "license": "MIT",
  "dimensions": {
    "width": 1920,
    "height": 1080
  },
  "duration": 7.5,
  "files": [
    {
      "path": "index.html",
      "target": "compositions/dither-type.html",
      "type": "hyperframes:composition"
    },
    {
      "path": "hyperbits.iife.js",
      "target": "compositions/hyperbits.iife.js",
      "type": "hyperframes:asset"
    }
  ],
  "variables": [
    {
      "id": "headline",
      "type": "string",
      "label": "Headline",
      "default": "Ship the frame"
    },
    {
      "id": "subline",
      "type": "string",
      "label": "Subline",
      "default": "ORDERED DITHER / 3 INKS / 1 BIT PER INK"
    },
    {
      "id": "background",
      "type": "color",
      "label": "Background",
      "default": "#100f0f"
    },
    {
      "id": "foreground",
      "type": "color",
      "label": "Highlight ink",
      "default": "#f2f0e5"
    },
    {
      "id": "accent",
      "type": "color",
      "label": "Accent ink",
      "default": "#ec8b49"
    }
  ]
}
