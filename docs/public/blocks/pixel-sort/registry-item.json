{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "pixel-sort",
  "type": "hyperframes:block",
  "title": "Pixel Sort",
  "description": "A sunset title card torn apart by brightness-sorted pixel runs that drip down each column, settling into the clean frame before a sweeping band glitches it again",
  "tags": [
    "text",
    "glitch",
    "pixel",
    "retro",
    "title"
  ],
  "license": "MIT",
  "dimensions": {
    "width": 1920,
    "height": 1080
  },
  "duration": 8,
  "files": [
    {
      "path": "index.html",
      "target": "compositions/pixel-sort.html",
      "type": "hyperframes:composition"
    },
    {
      "path": "hyperbits.iife.js",
      "target": "compositions/hyperbits.iife.js",
      "type": "hyperframes:asset"
    }
  ],
  "variables": [
    {
      "id": "headline",
      "type": "string",
      "label": "Headline",
      "default": "Sorted by light"
    },
    {
      "id": "label",
      "type": "string",
      "label": "Label",
      "default": "SIDE A / TRACK 04"
    },
    {
      "id": "background",
      "type": "color",
      "label": "Background",
      "default": "#100f0f"
    },
    {
      "id": "foreground",
      "type": "color",
      "label": "Foreground",
      "default": "#f2f0e5"
    },
    {
      "id": "accent",
      "type": "color",
      "label": "Accent",
      "default": "#ec8b49"
    }
  ]
}
