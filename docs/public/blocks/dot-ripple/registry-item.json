{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "dot-ripple",
  "type": "hyperframes:block",
  "title": "Ripple Plane",
  "description": "A gently tilted plane of dots filling the frame, slow ripples from three points lifting it in soft waves",
  "tags": [
    "loop",
    "background",
    "dots",
    "ripple",
    "plane"
  ],
  "license": "MIT",
  "dimensions": {
    "width": 1920,
    "height": 1080
  },
  "duration": 12,
  "files": [
    {
      "path": "index.html",
      "target": "compositions/dot-ripple.html",
      "type": "hyperframes:composition"
    },
    {
      "path": "hyperbits.iife.js",
      "target": "compositions/hyperbits.iife.js",
      "type": "hyperframes:asset"
    }
  ],
  "variables": [
    {
      "id": "background",
      "type": "color",
      "label": "Background",
      "default": "#100f0f"
    },
    {
      "id": "foreground",
      "type": "color",
      "label": "Foreground",
      "default": "#f2f0e5"
    },
    {
      "id": "accent",
      "type": "color",
      "label": "Accent",
      "default": "#ef5da8"
    },
    {
      "id": "wavelength",
      "type": "number",
      "label": "Wavelength",
      "default": 2.4
    }
  ]
}
