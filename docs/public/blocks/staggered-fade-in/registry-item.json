{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "staggered-fade-in",
  "type": "hyperframes:block",
  "title": "Staggered Fade In",
  "description": "Elements fading in sequentially",
  "tags": [
    "motion",
    "stagger",
    "fade"
  ],
  "license": "MIT",
  "dimensions": {
    "width": 1920,
    "height": 1080
  },
  "duration": 3,
  "files": [
    {
      "path": "index.html",
      "target": "compositions/staggered-fade-in.html",
      "type": "hyperframes:composition"
    },
    {
      "path": "hyperbits.iife.js",
      "target": "compositions/hyperbits.iife.js",
      "type": "hyperframes:asset"
    }
  ],
  "variables": [
    {
      "id": "color",
      "type": "color",
      "label": "Accent",
      "default": "#3b82f6"
    },
    {
      "id": "background",
      "type": "color",
      "label": "Background",
      "default": "#0f172a"
    }
  ]
}
