{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "particles-snow",
  "type": "hyperframes:block",
  "title": "Snow",
  "description": "Falling snow particles effect",
  "tags": [
    "particles",
    "snow",
    "weather"
  ],
  "license": "MIT",
  "dimensions": {
    "width": 1920,
    "height": 1080
  },
  "duration": 10,
  "files": [
    {
      "path": "index.html",
      "target": "compositions/particles-snow.html",
      "type": "hyperframes:composition"
    },
    {
      "path": "hyperbits.iife.js",
      "target": "compositions/hyperbits.iife.js",
      "type": "hyperframes:asset"
    }
  ],
  "variables": [
    {
      "id": "color",
      "type": "color",
      "label": "Flake color",
      "default": "#ffffff"
    },
    {
      "id": "background",
      "type": "color",
      "label": "Background",
      "default": "#01050e"
    }
  ]
}
