{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "moire-field",
  "type": "hyperframes:block",
  "title": "Moire Interference",
  "description": "Two sets of concentric rings combined with XOR so their interference blooms into shifting moire fringes as the centres orbit, drift apart and meet",
  "tags": [
    "background",
    "op-art",
    "pattern",
    "generative"
  ],
  "license": "MIT",
  "dimensions": {
    "width": 1920,
    "height": 1080
  },
  "duration": 10,
  "files": [
    {
      "path": "index.html",
      "target": "compositions/moire-field.html",
      "type": "hyperframes:composition"
    },
    {
      "path": "hyperbits.iife.js",
      "target": "compositions/hyperbits.iife.js",
      "type": "hyperframes:asset"
    }
  ],
  "variables": [
    {
      "id": "spacing",
      "type": "number",
      "label": "Ring spacing (vmin)",
      "default": 1.6
    },
    {
      "id": "background",
      "type": "color",
      "label": "Background",
      "default": "#100f0f"
    },
    {
      "id": "foreground",
      "type": "color",
      "label": "Highlight",
      "default": "#f2f0e5"
    },
    {
      "id": "accent",
      "type": "color",
      "label": "Ink",
      "default": "#ec8b49"
    }
  ]
}
