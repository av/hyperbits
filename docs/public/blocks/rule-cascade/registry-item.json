{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "rule-cascade",
  "type": "hyperframes:block",
  "title": "Rule Cascade",
  "description": "Elementary cellular automata growing generation by generation and scrolling upward, switching between rules 30, 90, 110 and 45 under a lookup-table legend, the newest generation glowing",
  "tags": [
    "background",
    "generative",
    "pattern",
    "math",
    "pixel"
  ],
  "license": "MIT",
  "dimensions": {
    "width": 1920,
    "height": 1080
  },
  "duration": 10,
  "files": [
    {
      "path": "index.html",
      "target": "compositions/rule-cascade.html",
      "type": "hyperframes:composition"
    },
    {
      "path": "hyperbits.iife.js",
      "target": "compositions/hyperbits.iife.js",
      "type": "hyperframes:asset"
    }
  ],
  "variables": [
    {
      "id": "rules",
      "type": "string",
      "label": "Rules, comma separated",
      "default": "30,90,110,45"
    },
    {
      "id": "background",
      "type": "color",
      "label": "Background",
      "default": "#100f0f"
    },
    {
      "id": "foreground",
      "type": "color",
      "label": "Cells",
      "default": "#f2f0e5"
    },
    {
      "id": "accent",
      "type": "color",
      "label": "Newest cells",
      "default": "#ec8b49"
    }
  ]
}
