{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "flying-through-words",
  "type": "hyperframes:block",
  "title": "Flying Through Words",
  "description": "Words spawning and flying past the camera",
  "tags": [
    "particles",
    "text",
    "3d",
    "flythrough"
  ],
  "license": "MIT",
  "dimensions": {
    "width": 1920,
    "height": 1080
  },
  "duration": 10,
  "files": [
    {
      "path": "index.html",
      "target": "compositions/flying-through-words.html",
      "type": "hyperframes:composition"
    },
    {
      "path": "hyperbits.iife.js",
      "target": "compositions/hyperbits.iife.js",
      "type": "hyperframes:asset"
    }
  ],
  "variables": [
    {
      "id": "words",
      "type": "string",
      "label": "Words (comma separated)",
      "default": "GPT,Claude,PaLM,Gemini,LLaMA,Mistral,Mixtral,Falcon,BLOOM,Kimi,MiniMax,Qwen"
    },
    {
      "id": "color",
      "type": "color",
      "label": "Word color",
      "default": "#fcc192"
    },
    {
      "id": "background",
      "type": "color",
      "label": "Background",
      "default": "#100f0f"
    }
  ]
}
