{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "radar-sweep",
  "type": "hyperframes:block",
  "title": "Radar Sweep",
  "description": "A phosphor radar scope with a conic afterglow beam, moving contacts that flare and fade as the sweep passes, ground clutter, bearing ring and a live contact table",
  "tags": [
    "hud",
    "data",
    "ui",
    "crt"
  ],
  "license": "MIT",
  "dimensions": {
    "width": 1920,
    "height": 1080
  },
  "duration": 10,
  "files": [
    {
      "path": "index.html",
      "target": "compositions/radar-sweep.html",
      "type": "hyperframes:composition"
    },
    {
      "path": "hyperbits.iife.js",
      "target": "compositions/hyperbits.iife.js",
      "type": "hyperframes:asset"
    }
  ],
  "variables": [
    {
      "id": "title",
      "type": "string",
      "label": "Panel title",
      "default": "SECTOR 7 / LIVE CONTACTS"
    },
    {
      "id": "seed",
      "type": "number",
      "label": "Seed",
      "default": 5
    },
    {
      "id": "background",
      "type": "color",
      "label": "Background",
      "default": "#100f0f"
    },
    {
      "id": "foreground",
      "type": "color",
      "label": "Text",
      "default": "#f2f0e5"
    },
    {
      "id": "accent",
      "type": "color",
      "label": "Phosphor",
      "default": "#ec8b49"
    }
  ]
}
