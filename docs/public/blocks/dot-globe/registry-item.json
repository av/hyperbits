{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "dot-globe",
  "type": "hyperframes:block",
  "title": "Network Globe",
  "description": "A turning globe of land dots under a faint graticule, great-circle arcs launching between cities with travelling packets and landing pings, beside a live counter",
  "tags": [
    "3d",
    "data",
    "globe",
    "network",
    "dots"
  ],
  "license": "MIT",
  "dimensions": {
    "width": 1920,
    "height": 1080
  },
  "duration": 10,
  "files": [
    {
      "path": "index.html",
      "target": "compositions/dot-globe.html",
      "type": "hyperframes:composition"
    },
    {
      "path": "hyperbits.iife.js",
      "target": "compositions/hyperbits.iife.js",
      "type": "hyperframes:asset"
    }
  ],
  "variables": [
    {
      "id": "label",
      "type": "string",
      "label": "Counter label",
      "default": "regions online"
    },
    {
      "id": "count",
      "type": "number",
      "label": "Counter value",
      "default": 142
    },
    {
      "id": "seed",
      "type": "number",
      "label": "Seed",
      "default": 3
    },
    {
      "id": "background",
      "type": "color",
      "label": "Background",
      "default": "#100f0f"
    },
    {
      "id": "foreground",
      "type": "color",
      "label": "Land dots",
      "default": "#f2f0e5"
    },
    {
      "id": "accent",
      "type": "color",
      "label": "Accent",
      "default": "#ec8b49"
    }
  ]
}
