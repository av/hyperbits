{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "riso-print",
  "type": "hyperframes:block",
  "title": "Riso Print",
  "description": "A two-ink risograph poster on warm paper: a grainy halftone sun stamps down, then orange and black ink passes slide into near-registration and overprint, with crop and registration marks",
  "tags": [
    "text",
    "print",
    "grain",
    "halftone",
    "paper"
  ],
  "license": "MIT",
  "dimensions": {
    "width": 1920,
    "height": 1080
  },
  "duration": 7,
  "files": [
    {
      "path": "index.html",
      "target": "compositions/riso-print.html",
      "type": "hyperframes:composition"
    },
    {
      "path": "hyperbits.iife.js",
      "target": "compositions/hyperbits.iife.js",
      "type": "hyperframes:asset"
    }
  ],
  "variables": [
    {
      "id": "headline",
      "type": "string",
      "label": "Headline",
      "default": "Make it move"
    },
    {
      "id": "caption",
      "type": "string",
      "label": "Caption",
      "default": "TWO INK RISO / ISSUE 09 / 2026"
    },
    {
      "id": "background",
      "type": "color",
      "label": "Paper",
      "default": "#f2f0e5"
    },
    {
      "id": "foreground",
      "type": "color",
      "label": "Black ink",
      "default": "#100f0f"
    },
    {
      "id": "accent",
      "type": "color",
      "label": "Spot ink",
      "default": "#ec8b49"
    }
  ]
}
