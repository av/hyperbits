{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "split-flap",
  "type": "hyperframes:block",
  "title": "Split-Flap Board",
  "description": "A departure-board message where every tile riffles through the alphabet on hinged 3D flaps before landing on its letter, sweeping in a diagonal wave",
  "tags": [
    "text",
    "mechanical",
    "flip",
    "3d",
    "retro"
  ],
  "license": "MIT",
  "dimensions": {
    "width": 1920,
    "height": 1080
  },
  "duration": 7,
  "files": [
    {
      "path": "index.html",
      "target": "compositions/split-flap.html",
      "type": "hyperframes:composition"
    },
    {
      "path": "hyperbits.iife.js",
      "target": "compositions/hyperbits.iife.js",
      "type": "hyperframes:asset"
    }
  ],
  "variables": [
    {
      "id": "headline",
      "type": "string",
      "label": "Headline",
      "default": "NOW BOARDING HYPERBITS"
    },
    {
      "id": "status",
      "type": "string",
      "label": "Status line",
      "default": "GATE 09  ON TIME"
    },
    {
      "id": "background",
      "type": "color",
      "label": "Background",
      "default": "#100f0f"
    },
    {
      "id": "foreground",
      "type": "color",
      "label": "Letters",
      "default": "#f2f0e5"
    },
    {
      "id": "accent",
      "type": "color",
      "label": "Accent",
      "default": "#ec8b49"
    }
  ]
}
