{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "op-art-lens",
  "type": "hyperframes:block",
  "title": "Op-Art Lens",
  "description": "A Vasarely-style checkerboard swelling under a travelling magnifying lens and pinching under a second, with an accent band of cells sweeping diagonally through the warp",
  "tags": [
    "background",
    "op-art",
    "pattern",
    "warp"
  ],
  "license": "MIT",
  "dimensions": {
    "width": 1920,
    "height": 1080
  },
  "duration": 10,
  "files": [
    {
      "path": "index.html",
      "target": "compositions/op-art-lens.html",
      "type": "hyperframes:composition"
    },
    {
      "path": "hyperbits.iife.js",
      "target": "compositions/hyperbits.iife.js",
      "type": "hyperframes:asset"
    }
  ],
  "variables": [
    {
      "id": "cells",
      "type": "number",
      "label": "Cells across",
      "default": 32
    },
    {
      "id": "background",
      "type": "color",
      "label": "Dark cells",
      "default": "#100f0f"
    },
    {
      "id": "foreground",
      "type": "color",
      "label": "Light cells",
      "default": "#f2f0e5"
    },
    {
      "id": "accent",
      "type": "color",
      "label": "Accent",
      "default": "#ec8b49"
    }
  ]
}
