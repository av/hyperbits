{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "chat-conversation",
  "type": "hyperframes:block",
  "title": "Chat Conversation",
  "description": "Messaging-app style conversation with bubbles arriving one after another.",
  "tags": [
    "chat",
    "messages",
    "ui",
    "staggered-motion",
    "product-demo"
  ],
  "license": "MIT",
  "dimensions": {
    "width": 1080,
    "height": 1920
  },
  "duration": 5,
  "files": [
    {
      "path": "index.html",
      "target": "compositions/chat-conversation.html",
      "type": "hyperframes:composition"
    },
    {
      "path": "hyperbits.iife.js",
      "target": "compositions/hyperbits.iife.js",
      "type": "hyperframes:asset"
    }
  ],
  "variables": [
    {
      "id": "message",
      "type": "string",
      "label": "First message",
      "default": "Hey, did the render finish?"
    },
    {
      "id": "color",
      "type": "color",
      "label": "My bubble color",
      "default": "#ec8b49"
    },
    {
      "id": "background",
      "type": "color",
      "label": "Background",
      "default": "#100f0f"
    }
  ]
}
