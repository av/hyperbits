{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "wire-solids",
  "type": "hyperframes:block",
  "title": "Hidden-Line Solids",
  "description": "The five Platonic solids turning in technical line art, visible edges solid and hidden edges dashed, each drawn edge by edge and named with its Schlafli symbol and V E F counts",
  "tags": [
    "3d",
    "line-art",
    "geometry",
    "math",
    "technical"
  ],
  "license": "MIT",
  "dimensions": {
    "width": 1920,
    "height": 1080
  },
  "duration": 10,
  "files": [
    {
      "path": "index.html",
      "target": "compositions/wire-solids.html",
      "type": "hyperframes:composition"
    },
    {
      "path": "hyperbits.iife.js",
      "target": "compositions/hyperbits.iife.js",
      "type": "hyperframes:asset"
    }
  ],
  "variables": [
    {
      "id": "caption",
      "type": "string",
      "label": "Caption",
      "default": "FIVE REGULAR SOLIDS"
    },
    {
      "id": "background",
      "type": "color",
      "label": "Background",
      "default": "#100f0f"
    },
    {
      "id": "foreground",
      "type": "color",
      "label": "Line ink",
      "default": "#f2f0e5"
    },
    {
      "id": "accent",
      "type": "color",
      "label": "Accent",
      "default": "#ec8b49"
    }
  ]
}
