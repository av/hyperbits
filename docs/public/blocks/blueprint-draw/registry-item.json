{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "blueprint-draw",
  "type": "hyperframes:block",
  "title": "Blueprint Drawing",
  "description": "A technical drawing that plots itself: centrelines, a bolted flange and its hatched section view, dimension lines with arrowheads and callouts, a title block, then an approval stamp",
  "tags": [
    "technical",
    "line-art",
    "explainer",
    "svg"
  ],
  "license": "MIT",
  "dimensions": {
    "width": 1920,
    "height": 1080
  },
  "duration": 10,
  "files": [
    {
      "path": "index.html",
      "target": "compositions/blueprint-draw.html",
      "type": "hyperframes:composition"
    },
    {
      "path": "hyperbits.iife.js",
      "target": "compositions/hyperbits.iife.js",
      "type": "hyperframes:asset"
    }
  ],
  "variables": [
    {
      "id": "title",
      "type": "string",
      "label": "Drawing title",
      "default": "FLANGE COUPLING"
    },
    {
      "id": "part",
      "type": "string",
      "label": "Part number",
      "default": "HB-0907"
    },
    {
      "id": "background",
      "type": "color",
      "label": "Background",
      "default": "#100f0f"
    },
    {
      "id": "foreground",
      "type": "color",
      "label": "Line ink",
      "default": "#f2f0e5"
    },
    {
      "id": "accent",
      "type": "color",
      "label": "Dimension ink",
      "default": "#ec8b49"
    }
  ]
}
