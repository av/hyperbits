{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "hard-light",
  "type": "hyperframes:block",
  "title": "Hard Light",
  "description": "A top-down field of turning blocks lit by a wandering point light that throws long soft-edged shadows across a glowing floor, the shadow fan swinging as the light orbits",
  "tags": [
    "background",
    "light",
    "shadow",
    "geometry"
  ],
  "license": "MIT",
  "dimensions": {
    "width": 1920,
    "height": 1080
  },
  "duration": 10,
  "files": [
    {
      "path": "index.html",
      "target": "compositions/hard-light.html",
      "type": "hyperframes:composition"
    },
    {
      "path": "hyperbits.iife.js",
      "target": "compositions/hyperbits.iife.js",
      "type": "hyperframes:asset"
    }
  ],
  "variables": [
    {
      "id": "caption",
      "type": "string",
      "label": "Caption",
      "default": "LIGHT STUDY 04"
    },
    {
      "id": "seed",
      "type": "number",
      "label": "Seed",
      "default": 6
    },
    {
      "id": "background",
      "type": "color",
      "label": "Shadow",
      "default": "#100f0f"
    },
    {
      "id": "foreground",
      "type": "color",
      "label": "Blocks",
      "default": "#f2f0e5"
    },
    {
      "id": "accent",
      "type": "color",
      "label": "Light",
      "default": "#ec8b49"
    }
  ]
}
