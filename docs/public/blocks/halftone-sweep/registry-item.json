{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "halftone-sweep",
  "type": "hyperframes:block",
  "title": "Halftone Clouds",
  "description": "A square halftone screen where soft clouds of larger dots drift in small slow circles across the whole frame",
  "tags": [
    "loop",
    "background",
    "dots",
    "halftone",
    "clouds"
  ],
  "license": "MIT",
  "dimensions": {
    "width": 1920,
    "height": 1080
  },
  "duration": 12,
  "files": [
    {
      "path": "index.html",
      "target": "compositions/halftone-sweep.html",
      "type": "hyperframes:composition"
    },
    {
      "path": "hyperbits.iife.js",
      "target": "compositions/hyperbits.iife.js",
      "type": "hyperframes:asset"
    }
  ],
  "variables": [
    {
      "id": "background",
      "type": "color",
      "label": "Background",
      "default": "#100f0f"
    },
    {
      "id": "foreground",
      "type": "color",
      "label": "Foreground",
      "default": "#f2f0e5"
    },
    {
      "id": "accent",
      "type": "color",
      "label": "Accent",
      "default": "#ef5da8"
    },
    {
      "id": "pitch",
      "type": "number",
      "label": "Dot pitch (vmin)",
      "default": 2.2
    }
  ]
}
