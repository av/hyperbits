{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "fracture-reassemble",
  "type": "hyperframes:block",
  "title": "Fracture Reassemble",
  "description": "Grid of tiles shatters into 3D space and reassembles with abstract symbol accents",
  "tags": [
    "motion",
    "staggered-motion",
    "fracture",
    "3d",
    "transition"
  ],
  "license": "MIT",
  "dimensions": {
    "width": 1080,
    "height": 1080
  },
  "duration": 6,
  "files": [
    {
      "path": "index.html",
      "target": "compositions/fracture-reassemble.html",
      "type": "hyperframes:composition"
    },
    {
      "path": "hyperbits.iife.js",
      "target": "compositions/hyperbits.iife.js",
      "type": "hyperframes:asset"
    }
  ],
  "variables": [
    {
      "id": "color",
      "type": "color",
      "label": "Tile outline",
      "default": "#100f0f"
    },
    {
      "id": "background",
      "type": "color",
      "label": "Background",
      "default": "#100f0f"
    }
  ]
}
