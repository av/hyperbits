{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "zoom-polygons",
  "type": "hyperframes:block",
  "title": "Polygon Drift",
  "description": "Hexagon outlines in three depth layers circling slowly in place with parallax, turning a sixth per loop",
  "tags": [
    "loop",
    "background",
    "depth",
    "polygons",
    "parallax"
  ],
  "license": "MIT",
  "dimensions": {
    "width": 1920,
    "height": 1080
  },
  "duration": 12,
  "files": [
    {
      "path": "index.html",
      "target": "compositions/zoom-polygons.html",
      "type": "hyperframes:composition"
    },
    {
      "path": "hyperbits.iife.js",
      "target": "compositions/hyperbits.iife.js",
      "type": "hyperframes:asset"
    }
  ],
  "variables": [
    {
      "id": "background",
      "type": "color",
      "label": "Background",
      "default": "#100f0f"
    },
    {
      "id": "foreground",
      "type": "color",
      "label": "Foreground",
      "default": "#f2f0e5"
    },
    {
      "id": "accent",
      "type": "color",
      "label": "Accent",
      "default": "#4fb6ec"
    },
    {
      "id": "sides",
      "type": "number",
      "label": "Polygon sides",
      "default": 6
    },
    {
      "id": "count",
      "type": "number",
      "label": "Polygons",
      "default": 54
    }
  ]
}
