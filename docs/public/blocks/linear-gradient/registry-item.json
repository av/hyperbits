{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "linear-gradient",
  "type": "hyperframes:block",
  "title": "Linear Gradient",
  "description": "Smooth transition between linear gradients",
  "tags": [
    "background",
    "gradient",
    "linear"
  ],
  "license": "MIT",
  "dimensions": {
    "width": 1920,
    "height": 1080
  },
  "duration": 3,
  "files": [
    {
      "path": "index.html",
      "target": "compositions/linear-gradient.html",
      "type": "hyperframes:composition"
    },
    {
      "path": "hyperbits.iife.js",
      "target": "compositions/hyperbits.iife.js",
      "type": "hyperframes:asset"
    }
  ],
  "variables": [
    {
      "id": "color1Start",
      "type": "color",
      "label": "Gradient 1 Start",
      "default": "#051226"
    },
    {
      "id": "color1End",
      "type": "color",
      "label": "Gradient 1 End",
      "default": "#1e0541"
    },
    {
      "id": "color2Start",
      "type": "color",
      "label": "Gradient 2 Start",
      "default": "#a5d4dd"
    },
    {
      "id": "color2End",
      "type": "color",
      "label": "Gradient 2 End",
      "default": "#5674b1"
    }
  ]
}
