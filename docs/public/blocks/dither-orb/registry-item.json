{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "dither-orb",
  "type": "hyperframes:block",
  "title": "Dithered Planet",
  "description": "A ringed planet raytraced per pixel and printed in three-ink Bayer dithering, its light swinging from a thin crescent to full day under a mono HUD",
  "tags": [
    "3d",
    "dither",
    "pixel",
    "retro",
    "hud"
  ],
  "license": "MIT",
  "dimensions": {
    "width": 1920,
    "height": 1080
  },
  "duration": 10,
  "files": [
    {
      "path": "index.html",
      "target": "compositions/dither-orb.html",
      "type": "hyperframes:composition"
    },
    {
      "path": "hyperbits.iife.js",
      "target": "compositions/hyperbits.iife.js",
      "type": "hyperframes:asset"
    }
  ],
  "variables": [
    {
      "id": "caption",
      "type": "string",
      "label": "Caption",
      "default": "SYSTEM 09 / OUTER RING"
    },
    {
      "id": "background",
      "type": "color",
      "label": "Background",
      "default": "#100f0f"
    },
    {
      "id": "foreground",
      "type": "color",
      "label": "Highlight ink",
      "default": "#f2f0e5"
    },
    {
      "id": "accent",
      "type": "color",
      "label": "Accent ink",
      "default": "#ec8b49"
    }
  ]
}
