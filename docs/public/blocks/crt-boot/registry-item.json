{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "crt-boot",
  "type": "hyperframes:block",
  "title": "CRT Power-On",
  "description": "A curved amber CRT snapping on from a single dot, booting through a typed self-test and progress bar to a glowing title, with scanlines, rolling bar and bloom, then collapsing off",
  "tags": [
    "text",
    "crt",
    "terminal",
    "retro",
    "glow"
  ],
  "license": "MIT",
  "dimensions": {
    "width": 1920,
    "height": 1080
  },
  "duration": 8,
  "files": [
    {
      "path": "index.html",
      "target": "compositions/crt-boot.html",
      "type": "hyperframes:composition"
    },
    {
      "path": "hyperbits.iife.js",
      "target": "compositions/hyperbits.iife.js",
      "type": "hyperframes:asset"
    }
  ],
  "variables": [
    {
      "id": "title",
      "type": "string",
      "label": "Title",
      "default": "HYPERBITS"
    },
    {
      "id": "subtitle",
      "type": "string",
      "label": "Subtitle",
      "default": "motion bits for hyperframes"
    },
    {
      "id": "background",
      "type": "color",
      "label": "Background",
      "default": "#100f0f"
    },
    {
      "id": "foreground",
      "type": "color",
      "label": "Hot phosphor",
      "default": "#f2f0e5"
    },
    {
      "id": "accent",
      "type": "color",
      "label": "Phosphor",
      "default": "#ec8b49"
    }
  ]
}
