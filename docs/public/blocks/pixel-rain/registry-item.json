{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "pixel-rain",
  "type": "hyperframes:block",
  "title": "Pixel Rain",
  "description": "Slanting pixel rain that lands and splashes at different depths across the whole frame",
  "tags": [
    "loop",
    "background",
    "dots",
    "pixel",
    "rain"
  ],
  "license": "MIT",
  "dimensions": {
    "width": 1920,
    "height": 1080
  },
  "duration": 12,
  "files": [
    {
      "path": "index.html",
      "target": "compositions/pixel-rain.html",
      "type": "hyperframes:composition"
    },
    {
      "path": "hyperbits.iife.js",
      "target": "compositions/hyperbits.iife.js",
      "type": "hyperframes:asset"
    }
  ],
  "variables": [
    {
      "id": "background",
      "type": "color",
      "label": "Background",
      "default": "#100f0f"
    },
    {
      "id": "foreground",
      "type": "color",
      "label": "Foreground",
      "default": "#f2f0e5"
    },
    {
      "id": "accent",
      "type": "color",
      "label": "Accent",
      "default": "#ef5da8"
    },
    {
      "id": "columns",
      "type": "number",
      "label": "Columns",
      "default": 96
    },
    {
      "id": "seed",
      "type": "number",
      "label": "Seed",
      "default": 2
    }
  ]
}
