{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "gyro-rings",
  "type": "hyperframes:block",
  "title": "Orbit Arcs",
  "description": "Wide orbital arcs around a sun far beyond the frame, small planets gliding along them in whole-number periods",
  "tags": [
    "loop",
    "background",
    "depth",
    "rings",
    "orbit"
  ],
  "license": "MIT",
  "dimensions": {
    "width": 1920,
    "height": 1080
  },
  "duration": 12,
  "files": [
    {
      "path": "index.html",
      "target": "compositions/gyro-rings.html",
      "type": "hyperframes:composition"
    },
    {
      "path": "hyperbits.iife.js",
      "target": "compositions/hyperbits.iife.js",
      "type": "hyperframes:asset"
    }
  ],
  "variables": [
    {
      "id": "background",
      "type": "color",
      "label": "Background",
      "default": "#100f0f"
    },
    {
      "id": "foreground",
      "type": "color",
      "label": "Foreground",
      "default": "#f2f0e5"
    },
    {
      "id": "accent",
      "type": "color",
      "label": "Accent",
      "default": "#4fb6ec"
    },
    {
      "id": "rings",
      "type": "number",
      "label": "Orbits",
      "default": 16
    },
    {
      "id": "seed",
      "type": "number",
      "label": "Seed",
      "default": 3
    }
  ]
}
