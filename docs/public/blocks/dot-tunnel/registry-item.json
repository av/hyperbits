{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "dot-tunnel",
  "type": "hyperframes:block",
  "title": "Helix Field",
  "description": "Stacked dotted tubes seen from the side, their rings slowly turning into helix stripes across the whole frame",
  "tags": [
    "loop",
    "background",
    "depth",
    "tunnel",
    "dotted"
  ],
  "license": "MIT",
  "dimensions": {
    "width": 1920,
    "height": 1080
  },
  "duration": 12,
  "files": [
    {
      "path": "index.html",
      "target": "compositions/dot-tunnel.html",
      "type": "hyperframes:composition"
    },
    {
      "path": "hyperbits.iife.js",
      "target": "compositions/hyperbits.iife.js",
      "type": "hyperframes:asset"
    }
  ],
  "variables": [
    {
      "id": "background",
      "type": "color",
      "label": "Background",
      "default": "#100f0f"
    },
    {
      "id": "foreground",
      "type": "color",
      "label": "Foreground",
      "default": "#f2f0e5"
    },
    {
      "id": "accent",
      "type": "color",
      "label": "Accent",
      "default": "#4fb6ec"
    },
    {
      "id": "frames",
      "type": "number",
      "label": "Tubes",
      "default": 5
    },
    {
      "id": "dots",
      "type": "number",
      "label": "Dots per ring",
      "default": 12
    }
  ]
}
