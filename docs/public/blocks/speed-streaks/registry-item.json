{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "speed-streaks",
  "type": "hyperframes:block",
  "title": "Light Trails",
  "description": "Soft long-exposure light trails looping slowly in their own patch of the frame, spread evenly with no bright heads",
  "tags": [
    "loop",
    "background",
    "lines",
    "speed",
    "trails"
  ],
  "license": "MIT",
  "dimensions": {
    "width": 1920,
    "height": 1080
  },
  "duration": 12,
  "files": [
    {
      "path": "index.html",
      "target": "compositions/speed-streaks.html",
      "type": "hyperframes:composition"
    },
    {
      "path": "hyperbits.iife.js",
      "target": "compositions/hyperbits.iife.js",
      "type": "hyperframes:asset"
    }
  ],
  "variables": [
    {
      "id": "background",
      "type": "color",
      "label": "Background",
      "default": "#100f0f"
    },
    {
      "id": "foreground",
      "type": "color",
      "label": "Foreground",
      "default": "#f2f0e5"
    },
    {
      "id": "accent",
      "type": "color",
      "label": "Accent",
      "default": "#f2652a"
    },
    {
      "id": "streaks",
      "type": "number",
      "label": "Trails",
      "default": 20
    },
    {
      "id": "seed",
      "type": "number",
      "label": "Seed",
      "default": 9
    }
  ]
}
