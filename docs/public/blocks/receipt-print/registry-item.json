{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "receipt-print",
  "type": "hyperframes:block",
  "title": "Receipt Printer",
  "description": "A thermal receipt feeds up out of a printer line by line, each row burning in left to right down to a highlighted total and barcode, before the slip is torn off and flies away",
  "tags": [
    "list",
    "print",
    "paper",
    "component"
  ],
  "license": "MIT",
  "dimensions": {
    "width": 1920,
    "height": 1080
  },
  "duration": 8,
  "files": [
    {
      "path": "index.html",
      "target": "compositions/receipt-print.html",
      "type": "hyperframes:composition"
    },
    {
      "path": "hyperbits.iife.js",
      "target": "compositions/hyperbits.iife.js",
      "type": "hyperframes:asset"
    }
  ],
  "variables": [
    {
      "id": "store",
      "type": "string",
      "label": "Store name",
      "default": "HYPERBITS SUPPLY CO."
    },
    {
      "id": "items",
      "type": "string",
      "label": "Items as name:price, comma separated",
      "default": "Dithered planet:12.00,Split-flap board:8.50,ASCII torus:6.25,Isometric city:14.00,Vector scope:9.75"
    },
    {
      "id": "background",
      "type": "color",
      "label": "Background",
      "default": "#100f0f"
    },
    {
      "id": "foreground",
      "type": "color",
      "label": "Paper",
      "default": "#f2f0e5"
    },
    {
      "id": "accent",
      "type": "color",
      "label": "Accent",
      "default": "#ec8b49"
    }
  ]
}
