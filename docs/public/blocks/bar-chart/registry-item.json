{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "bar-chart",
  "type": "hyperframes:block",
  "title": "Bar Chart",
  "description": "Horizontal bar chart growing in with staggered bars and counting values.",
  "tags": [
    "chart",
    "data",
    "stats",
    "counter",
    "staggered-motion",
    "ui"
  ],
  "license": "MIT",
  "dimensions": {
    "width": 1920,
    "height": 1080
  },
  "duration": 4,
  "files": [
    {
      "path": "index.html",
      "target": "compositions/bar-chart.html",
      "type": "hyperframes:composition"
    },
    {
      "path": "hyperbits.iife.js",
      "target": "compositions/hyperbits.iife.js",
      "type": "hyperframes:asset"
    }
  ],
  "variables": [
    {
      "id": "title",
      "type": "string",
      "label": "Title",
      "default": "Weekly commits by language"
    },
    {
      "id": "color",
      "type": "color",
      "label": "Bar color",
      "default": "#ec8b49"
    },
    {
      "id": "background",
      "type": "color",
      "label": "Background",
      "default": "#100f0f"
    }
  ]
}
