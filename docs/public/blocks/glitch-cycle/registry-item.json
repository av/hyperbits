{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "glitch-cycle",
  "type": "hyperframes:block",
  "title": "Glitch Cycle",
  "description": "Cycling text with glitch transition effects between words",
  "tags": [
    "text",
    "glitch",
    "cycle"
  ],
  "license": "MIT",
  "dimensions": {
    "width": 1920,
    "height": 1080
  },
  "duration": 8,
  "files": [
    {
      "path": "index.html",
      "target": "compositions/glitch-cycle.html",
      "type": "hyperframes:composition"
    },
    {
      "path": "hyperbits.iife.js",
      "target": "compositions/hyperbits.iife.js",
      "type": "hyperframes:asset"
    }
  ],
  "variables": [
    {
      "id": "words",
      "type": "string",
      "label": "Words (comma separated)",
      "default": "INITIALIZING,LOADING ASSETS,SYSTEM ONLINE,WELCOME USER"
    },
    {
      "id": "color",
      "type": "color",
      "label": "Text color",
      "default": "#fcc192"
    },
    {
      "id": "background",
      "type": "color",
      "label": "Background",
      "default": "#100f0f"
    }
  ]
}
