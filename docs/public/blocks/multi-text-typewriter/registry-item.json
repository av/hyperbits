{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "multi-text-typewriter",
  "type": "hyperframes:block",
  "title": "Multi-Text Typewriter",
  "description": "Typing multiple sentences in sequence with deleting phase.",
  "tags": [
    "text",
    "typewriter",
    "sequence",
    "loop"
  ],
  "license": "MIT",
  "dimensions": {
    "width": 1920,
    "height": 1080
  },
  "duration": 10,
  "files": [
    {
      "path": "index.html",
      "target": "compositions/multi-text-typewriter.html",
      "type": "hyperframes:composition"
    },
    {
      "path": "hyperbits.iife.js",
      "target": "compositions/hyperbits.iife.js",
      "type": "hyperframes:asset"
    }
  ],
  "variables": [
    {
      "id": "lines",
      "type": "string",
      "label": "Sentences (| separated)",
      "default": "First sentence.|Second longer sentence.|Looping..."
    },
    {
      "id": "color",
      "type": "color",
      "label": "Text color",
      "default": "#fcc192"
    },
    {
      "id": "background",
      "type": "color",
      "label": "Background",
      "default": "#100f0f"
    }
  ]
}
