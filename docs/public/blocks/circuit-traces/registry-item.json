{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "circuit-traces",
  "type": "hyperframes:block",
  "title": "Circuit Traces",
  "description": "A chip in the centre of a dark PCB routes copper buses out to every edge with 45-degree bends and vias, then data packets race along the traces while the die glows",
  "tags": [
    "background",
    "hardware",
    "data",
    "lines",
    "technical"
  ],
  "license": "MIT",
  "dimensions": {
    "width": 1920,
    "height": 1080
  },
  "duration": 10,
  "files": [
    {
      "path": "index.html",
      "target": "compositions/circuit-traces.html",
      "type": "hyperframes:composition"
    },
    {
      "path": "hyperbits.iife.js",
      "target": "compositions/hyperbits.iife.js",
      "type": "hyperframes:asset"
    }
  ],
  "variables": [
    {
      "id": "chip",
      "type": "string",
      "label": "Chip label",
      "default": "HB-09"
    },
    {
      "id": "seed",
      "type": "number",
      "label": "Seed",
      "default": 9
    },
    {
      "id": "background",
      "type": "color",
      "label": "Board",
      "default": "#100f0f"
    },
    {
      "id": "foreground",
      "type": "color",
      "label": "Packets",
      "default": "#f2f0e5"
    },
    {
      "id": "accent",
      "type": "color",
      "label": "Copper",
      "default": "#ec8b49"
    }
  ]
}
