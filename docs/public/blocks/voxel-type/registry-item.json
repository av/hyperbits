{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "voxel-type",
  "type": "hyperframes:block",
  "title": "Voxel Type",
  "description": "Isometric voxels fly in from a scattered cloud and lock into a word built from a 5x7 pixel font, ripple with a travelling wave, then burst apart",
  "tags": [
    "3d",
    "isometric",
    "pixel",
    "typography",
    "logo"
  ],
  "license": "MIT",
  "dimensions": {
    "width": 1920,
    "height": 1080
  },
  "duration": 8,
  "files": [
    {
      "path": "index.html",
      "target": "compositions/voxel-type.html",
      "type": "hyperframes:composition"
    },
    {
      "path": "hyperbits.iife.js",
      "target": "compositions/hyperbits.iife.js",
      "type": "hyperframes:asset"
    }
  ],
  "variables": [
    {
      "id": "word",
      "type": "string",
      "label": "Word (up to 8 characters)",
      "default": "BITS"
    },
    {
      "id": "background",
      "type": "color",
      "label": "Background",
      "default": "#100f0f"
    },
    {
      "id": "foreground",
      "type": "color",
      "label": "Light face",
      "default": "#f2f0e5"
    },
    {
      "id": "accent",
      "type": "color",
      "label": "Voxel colour",
      "default": "#ec8b49"
    }
  ]
}
