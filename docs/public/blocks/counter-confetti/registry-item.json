{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "counter-confetti",
  "type": "hyperframes:block",
  "title": "Counter Confetti",
  "description": "Counter reaching 1000 with confetti particles bursting from the sides.",
  "tags": [
    "counter",
    "particles",
    "confetti",
    "celebration"
  ],
  "license": "MIT",
  "dimensions": {
    "width": 1920,
    "height": 1080
  },
  "duration": 6,
  "files": [
    {
      "path": "index.html",
      "target": "compositions/counter-confetti.html",
      "type": "hyperframes:composition"
    },
    {
      "path": "hyperbits.iife.js",
      "target": "compositions/hyperbits.iife.js",
      "type": "hyperframes:asset"
    }
  ],
  "variables": [
    {
      "id": "target",
      "type": "number",
      "label": "Target value",
      "default": 1000
    },
    {
      "id": "color",
      "type": "color",
      "label": "Text color",
      "default": "#fcc192"
    },
    {
      "id": "background",
      "type": "color",
      "label": "Background",
      "default": "#100f0f"
    }
  ]
}
