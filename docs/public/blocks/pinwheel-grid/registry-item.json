{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "pinwheel-grid",
  "type": "hyperframes:block",
  "title": "Pinwheel Meadow",
  "description": "A meadow of small paper pinwheels in receding rows filling the frame, turning slowly as soft gusts roll through",
  "tags": [
    "loop",
    "background",
    "shapes",
    "pinwheel",
    "meadow"
  ],
  "license": "MIT",
  "dimensions": {
    "width": 1920,
    "height": 1080
  },
  "duration": 12,
  "files": [
    {
      "path": "index.html",
      "target": "compositions/pinwheel-grid.html",
      "type": "hyperframes:composition"
    },
    {
      "path": "hyperbits.iife.js",
      "target": "compositions/hyperbits.iife.js",
      "type": "hyperframes:asset"
    }
  ],
  "variables": [
    {
      "id": "background",
      "type": "color",
      "label": "Background",
      "default": "#100f0f"
    },
    {
      "id": "foreground",
      "type": "color",
      "label": "Foreground",
      "default": "#f2f0e5"
    },
    {
      "id": "accent",
      "type": "color",
      "label": "Accent",
      "default": "#9d8af0"
    },
    {
      "id": "pinwheels",
      "type": "number",
      "label": "Pinwheels per row",
      "default": 14
    },
    {
      "id": "seed",
      "type": "number",
      "label": "Seed",
      "default": 5
    }
  ]
}
