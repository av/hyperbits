{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "basic-typewriter",
  "type": "hyperframes:block",
  "title": "Basic Typewriter",
  "description": "Simple typing animation with cursor.",
  "tags": [
    "text",
    "typewriter",
    "basic"
  ],
  "license": "MIT",
  "dimensions": {
    "width": 1920,
    "height": 1080
  },
  "duration": 5,
  "files": [
    {
      "path": "index.html",
      "target": "compositions/basic-typewriter.html",
      "type": "hyperframes:composition"
    },
    {
      "path": "hyperbits.iife.js",
      "target": "compositions/hyperbits.iife.js",
      "type": "hyperframes:asset"
    }
  ],
  "variables": [
    {
      "id": "text",
      "type": "string",
      "label": "Text",
      "default": "Ah, those sunny days!"
    },
    {
      "id": "color",
      "type": "color",
      "label": "Text color",
      "default": "#fcc192"
    },
    {
      "id": "background",
      "type": "color",
      "label": "Background",
      "default": "#100f0f"
    }
  ]
}
