{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "ray-burst",
  "type": "hyperframes:block",
  "title": "Sunburst Wash",
  "description": "Soft retro sunburst wedges fanning from far below the frame, turning slowly under faint rings rippling outward",
  "tags": [
    "loop",
    "background",
    "lines",
    "radial",
    "burst"
  ],
  "license": "MIT",
  "dimensions": {
    "width": 1920,
    "height": 1080
  },
  "duration": 12,
  "files": [
    {
      "path": "index.html",
      "target": "compositions/ray-burst.html",
      "type": "hyperframes:composition"
    },
    {
      "path": "hyperbits.iife.js",
      "target": "compositions/hyperbits.iife.js",
      "type": "hyperframes:asset"
    }
  ],
  "variables": [
    {
      "id": "background",
      "type": "color",
      "label": "Background",
      "default": "#f2f0e5"
    },
    {
      "id": "foreground",
      "type": "color",
      "label": "Foreground",
      "default": "#100f0f"
    },
    {
      "id": "accent",
      "type": "color",
      "label": "Accent",
      "default": "#f2652a"
    },
    {
      "id": "rays",
      "type": "number",
      "label": "Wedges",
      "default": 40
    }
  ]
}
