{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "odometer-roll",
  "type": "hyperframes:block",
  "title": "Odometer Roll",
  "description": "A mechanical counter of real 3D number drums: the ones wheel spins into a motion blur, higher wheels click over with true carries and everything settles on the target value",
  "tags": [
    "counter",
    "number",
    "3d",
    "mechanical",
    "component"
  ],
  "license": "MIT",
  "dimensions": {
    "width": 1920,
    "height": 1080
  },
  "duration": 6,
  "files": [
    {
      "path": "index.html",
      "target": "compositions/odometer-roll.html",
      "type": "hyperframes:composition"
    },
    {
      "path": "hyperbits.iife.js",
      "target": "compositions/hyperbits.iife.js",
      "type": "hyperframes:asset"
    }
  ],
  "variables": [
    {
      "id": "value",
      "type": "number",
      "label": "Target value",
      "default": 48213
    },
    {
      "id": "label",
      "type": "string",
      "label": "Label",
      "default": "renders this week"
    },
    {
      "id": "background",
      "type": "color",
      "label": "Background",
      "default": "#100f0f"
    },
    {
      "id": "foreground",
      "type": "color",
      "label": "Digits",
      "default": "#f2f0e5"
    },
    {
      "id": "accent",
      "type": "color",
      "label": "Accent",
      "default": "#ec8b49"
    }
  ]
}
