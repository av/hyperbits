{
  "$schema": "https://hyperframes.heygen.com/schema/registry-item.json",
  "name": "isometric-city",
  "type": "hyperframes:block",
  "title": "Isometric Skyline",
  "description": "Line-art city blocks rising out of an isometric grid with hidden-line removal, a slow orbiting camera, a scan ring lighting edges and windows flickering on",
  "tags": [
    "3d",
    "isometric",
    "line-art",
    "architecture",
    "generative"
  ],
  "license": "MIT",
  "dimensions": {
    "width": 1920,
    "height": 1080
  },
  "duration": 10,
  "files": [
    {
      "path": "index.html",
      "target": "compositions/isometric-city.html",
      "type": "hyperframes:composition"
    },
    {
      "path": "hyperbits.iife.js",
      "target": "compositions/hyperbits.iife.js",
      "type": "hyperframes:asset"
    }
  ],
  "variables": [
    {
      "id": "caption",
      "type": "string",
      "label": "Caption",
      "default": "BLOCK 07 / ELEVATION STUDY"
    },
    {
      "id": "seed",
      "type": "number",
      "label": "Seed",
      "default": 7
    },
    {
      "id": "background",
      "type": "color",
      "label": "Background",
      "default": "#100f0f"
    },
    {
      "id": "foreground",
      "type": "color",
      "label": "Line ink",
      "default": "#f2f0e5"
    },
    {
      "id": "accent",
      "type": "color",
      "label": "Accent",
      "default": "#ec8b49"
    }
  ]
}
