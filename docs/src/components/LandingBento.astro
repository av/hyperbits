---
import { Code } from "@astrojs/starlight/components";
import BentoCard from "./BentoCard.astro";

const textEffectCode = `<h1 class="clip" data-start="0" data-duration="4">
  Text Transition
</h1>

<script>
  hyperbits.stagger(words, {
    y: [40, 0],
    blur: [10, 0], // Word-by-word blur
    opacity: [0, 1],
    each: 0.12,
  });
</script>`;

const seed = (index: number) => {
  const value = Math.sin(index * 12.9898 + 78.233) * 43758.5453;
  return value - Math.floor(value);
};

const particles = Array.from({ length: 42 }, (_, index) => ({
  left: seed(index) * 100,
  top: seed(index + 100) * 100,
  size: [2, 4, 3][index % 3],
  tone: index % 3,
  duration: 6 + seed(index + 200) * 8,
  delay: -seed(index + 300) * 12,
}));
---

<div
  class="grid grid-cols-1 md:grid-cols-6 lg:grid-cols-6 gap-4 md:gap-6 auto-rows-[250px] md:auto-rows-[280px]"
  data-landing-bento
>
  <BentoCard class="md:col-span-6 lg:col-span-4">
    <div class="relative z-10 h-full flex flex-col md:flex-row gap-8 items-center">
      <div class="flex-1 min-w-0">
        <div
          class="w-12 h-12 rounded-lg bg-primary/10 flex items-center justify-center text-primary mb-4 border border-primary/20"
        >
          <span class="material-symbols-outlined text-2xl">text_fields</span>
        </div>
        <h3 class="text-2xl font-semibold text-white mb-2">Text Effects</h3>
        <p class="text-gray-400 text-sm max-w-md">
          Create complex typography animations with ease. Stagger characters, words, or
          lines. Combine blur, scale, and position offsets for professional reveals.
        </p>
      </div>
      <div class="flex-1 w-full hidden md:block">
        <div class="rounded-lg overflow-hidden border border-white/10 shadow-xl bg-[#0d1117] text-xs">
          <Code code={textEffectCode} lang="html" />
        </div>
      </div>
    </div>
  </BentoCard>
  <BentoCard class="md:col-span-3 lg:col-span-2">
    <div class="absolute inset-0 z-0 opacity-50 pointer-events-none bento-particles" aria-hidden="true">
      {
        particles.map((particle) => (
          <span
            class:list={["bento-particle", `bento-particle-${particle.tone}`]}
            style={`left:${particle.left}%;top:${particle.top}%;width:${particle.size}px;height:${particle.size}px;animation-duration:${particle.duration}s;animation-delay:${particle.delay}s;`}
          />
        ))
      }
    </div>
    <div class="relative z-10 h-full flex flex-col">
      <div
        class="w-12 h-12 rounded-lg bg-primary/10 flex items-center justify-center text-primary mb-4 border border-primary/20 bg-surface-light/80 backdrop-blur-sm"
      >
        <span class="material-symbols-outlined text-2xl">grain</span>
      </div>
      <h3 class="text-xl font-semibold text-white mb-2">Particle System</h3>
      <p class="text-gray-400 text-sm mb-4">
        A complete seeded particle engine. Simulate snow, confetti, or fireflies with
        customizable behaviors. Every render looks the same.
      </p>
    </div>
  </BentoCard>
  <BentoCard class="md:col-span-3 lg:col-span-2">
    <div class="relative z-10">
      <div
        class="w-12 h-12 rounded-lg bg-primary/10 flex items-center justify-center mb-4 border border-primary/20"
      >
        <div class="w-4 h-4 bento-motion-primitive"></div>
      </div>
      <h3 class="text-xl font-semibold text-white mb-2">Motion Primitives</h3>
      <p class="text-gray-400 text-sm">
        Declarative entry and exit animations. Chain fades, slides, and scaling with
        <code class="text-gray-300">hyperbits.stagger</code> without managing tweens by hand.
      </p>
    </div>
  </BentoCard>
  <BentoCard class="md:col-span-3 lg:col-span-2">
    <div
      class="absolute inset-0 z-0 bento-agent-shot"
      aria-hidden="true"
    >
      <pre class="bento-agent-pre"><code><span class="text-gray-500">$</span> npx hyperbits find "fade in"
<span class="text-primary">fade-in</span>              text-animations
<span class="text-primary">staggered-fade-in</span>    staggered-motion
<span class="text-primary">blur-slide-word</span>      text-animations

<span class="text-gray-500">$</span> npx hyperbits add staggered-fade-in
<span class="text-gray-500">  ✔ compositions/staggered-fade-in.html</span>
<span class="text-gray-500">$</span> npx hyperbits mcp
<span class="text-gray-500">  hyperbits MCP server listening on stdio</span></code></pre>
    </div>
    <div class="relative z-10 h-full">
      <div
        class="w-12 h-12 rounded-lg bg-primary/10 flex items-center justify-center text-primary mb-4 border border-primary/20"
      >
        <span class="material-symbols-outlined text-2xl">smart_toy</span>
      </div>
      <h3 class="text-xl font-semibold text-white mb-2">Agent Ready</h3>
      <p class="text-gray-400 text-sm mb-4">
        First-class CLI and MCP server. Your agent can search, read, and install every bit.
      </p>
    </div>
  </BentoCard>
  <BentoCard class="md:col-span-3 lg:col-span-2 flex flex-col">
    <div class="relative z-10 flex-1">
      <div
        class="w-12 h-12 rounded-lg bg-primary/10 flex items-center justify-center text-primary mb-4 border border-primary/20"
      >
        <span class="material-symbols-outlined text-2xl">content_copy</span>
      </div>
      <h3 class="text-xl font-semibold text-white mb-2">Copy-Paste Ready</h3>
      <p class="text-gray-400 text-sm">
        Install bits directly into your compositions. Own the HTML, customize endlessly, and
        suffer zero bloat.
      </p>
    </div>
  </BentoCard>
</div>

<style>
  .bento-particle {
    position: absolute;
    border-radius: 9999px;
    filter: blur(1px);
    animation-name: bentoParticleDrift;
    animation-timing-function: ease-in-out;
    animation-iteration-count: infinite;
  }
  .bento-particle-0 {
    background: rgba(236, 139, 73, 0.4);
  }
  .bento-particle-1 {
    background: rgba(255, 255, 255, 0.2);
  }
  .bento-particle-2 {
    background: rgba(236, 139, 73, 0.2);
    filter: none;
  }
  @keyframes bentoParticleDrift {
    0% {
      transform: translate(0, 40px);
      opacity: 0;
    }
    30% {
      opacity: 1;
    }
    70% {
      opacity: 1;
    }
    100% {
      transform: translate(12px, -60px);
      opacity: 0;
    }
  }
  .bento-motion-primitive {
    animation: bentoMotionPrimitive 3s ease-in-out infinite;
  }
  @keyframes bentoMotionPrimitive {
    0%,
    5% {
      transform: translate(-50%, -50%) rotate(0deg);
      border-radius: 0.25rem;
      background-color: var(--color-primary);
    }
    25%,
    30% {
      transform: translate(50%, -50%) rotate(90deg);
      border-radius: 50%;
      background-color: white;
    }
    50%,
    55% {
      transform: translate(50%, 50%) rotate(0deg);
      border-radius: 0.125rem;
      background-color: var(--color-primary);
    }
    75%,
    80% {
      transform: translate(-50%, 50%) rotate(-90deg);
      border-radius: 0 50% 50% 50%;
      background-color: white;
    }
    100% {
      transform: translate(-50%, -50%) rotate(0deg);
      border-radius: 0.25rem;
      background-color: var(--color-primary);
    }
  }
  .bento-agent-shot {
    mask-image: linear-gradient(to top, black, transparent 40%);
    -webkit-mask-image: linear-gradient(to top, black, transparent 40%);
    display: flex;
    align-items: flex-end;
  }
  .bento-agent-pre {
    margin: 0;
    padding: 0 0 0.75rem 0.5rem;
    font: 0.6rem/1.5 var(--font-mono);
    color: #d1d5db;
    white-space: pre;
    background: transparent;
  }
</style>
